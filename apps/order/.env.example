# ==============================================================================
# Sharon Tea & Coffee — Customer Ordering PWA (apps/order) Environment Variables
# Copy to .env and fill values before running in production. Never commit .env.
# ==============================================================================

# Backend API & Socket.io endpoints
VITE_API_BASE_URL=http://localhost:4100/api/v1
VITE_SOCKET_URL=http://localhost:4100

# Firebase Cloud Messaging (Web Push) — Public Web SDK config + VAPID key
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
